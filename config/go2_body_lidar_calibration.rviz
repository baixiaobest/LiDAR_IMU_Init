Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: li_init_go2_world
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/TF
      Name: Estimated LiDAR and body IMU frames
      Enabled: true
      Show Axes: true
      Show Arrows: true
      Show Names: true
      Marker Scale: 0.5
      Frame Timeout: 15
    - Class: rviz_default_plugins/Path
      Name: Estimated LiDAR path
      Enabled: true
      Topic:
        Value: /li_init_go2/path
        Depth: 10
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Line Style: Lines
      Line Width: 0.04
      Color: 255; 210; 30
      Alpha: 1
    - Class: rviz_default_plugins/PointCloud2
      Name: Registered LiDAR cloud
      Enabled: true
      Topic:
        Value: /li_init_go2/cloud_registered
        Depth: 5
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Style: Points
      Size (Pixels): 2
      Color Transformer: Intensity
    - Class: rviz_default_plugins/Odometry
      Name: Estimated LiDAR odometry
      Enabled: true
      Topic:
        Value: /li_init_go2/odom
        Depth: 10
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Shape: Axes
      Keep: 1
  Tools:
    - Class: rviz_default_plugins/Interact
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 8
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.65
      Yaw: 0.8
